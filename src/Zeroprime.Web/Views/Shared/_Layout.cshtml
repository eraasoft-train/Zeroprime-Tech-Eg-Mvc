<!DOCTYPE html>
<html lang="en">
<head>
    @{
        var pageTitle = ViewData["Title"] as string ?? "ZeroPrime Technologies";
        var pageDescription = ViewData["Description"] as string
            ?? "ZeroPrime Technologies is an Egyptian startup building smart, sustainable cities infrastructure and autonomous waste management solutions, starting with CanBank, a reverse vending machine.";
        var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var ogType = ViewData["OgType"] as string ?? "website";
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="~/js/theme.js"></script>
    <title>@pageTitle | ZeroPrime Technologies</title>
    <meta name="description" content="@pageDescription" />
    <link rel="canonical" href="@canonical" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="ZeroPrime Technologies" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@pageTitle | ZeroPrime Technologies" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:url" content="@canonical" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@pageTitle | ZeroPrime Technologies" />
    <meta name="twitter:description" content="@pageDescription" />

    <meta name="theme-color" content="#0e2f24" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" asp-append-version="true" />
    <link rel="alternate icon" href="~/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" sizes="180x180" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await Component.InvokeAsync("OrganizationSchema")
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>

<header class="zp-header" id="zpHeader">
    <div class="zp-container">
        <nav class="zp-navbar" aria-label="Main navigation">
            <a class="zp-brand" asp-controller="Home" asp-action="Index" aria-label="ZeroPrime Technologies - home">
                <img class="zp-logo zp-logo--dark" src="~/images/logo.svg" asp-append-version="true" alt="ZeroPrime Technologies" width="240" height="64" />
                <img class="zp-logo zp-logo--light" src="~/images/logo-light.svg" asp-append-version="true" alt="ZeroPrime Technologies" width="240" height="64" />
            </a>

            <div class="zp-nav-panel" id="zpNavPanel">
                <ul class="zp-nav-list">
                    <li><a class="zp-nav-link" asp-controller="Home" asp-action="Index" aria-current='@((ViewContext.RouteData.Values["controller"] as string)?.Equals("Home", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)'>Home</a></li>
                    <li><a class="zp-nav-link" asp-controller="About" asp-action="Index" aria-current='@((ViewContext.RouteData.Values["controller"] as string)?.Equals("About", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)'>About</a></li>
                    <li><a class="zp-nav-link" asp-controller="Products" asp-action="Index" aria-current='@((ViewContext.RouteData.Values["controller"] as string)?.Equals("Products", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)'>CanBank</a></li>
                    <li><a class="zp-nav-link" asp-controller="SmartCities" asp-action="Index" aria-current='@((ViewContext.RouteData.Values["controller"] as string)?.Equals("SmartCities", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)'>Smart Cities</a></li>
                    <li><a class="zp-nav-link" asp-controller="Contact" asp-action="Index" aria-current='@((ViewContext.RouteData.Values["controller"] as string)?.Equals("Contact", StringComparison.OrdinalIgnoreCase) == true ? "page" : null)'>Contact</a></li>
                </ul>
                <a class="zp-btn zp-btn--amber zp-btn--sm ms-lg-2 mt-2 mt-lg-0" asp-controller="Contact" asp-action="Index">Get in touch</a>
            </div>

            <button class="zp-theme-toggle" type="button" id="zpThemeToggle" aria-label="Toggle dark mode" aria-pressed="false">
                <svg class="icon-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7"/></svg>
                <svg class="icon-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.4 14.2A8.5 8.5 0 1 1 9.8 3.6a7 7 0 0 0 10.6 10.6z"/></svg>
            </button>

            <button class="zp-nav-toggle" type="button" id="zpNavToggle"
                    aria-expanded="false" aria-controls="zpNavPanel" aria-label="Toggle navigation">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M4 7h16M4 12h16M4 17h16" />
                </svg>
                <span class="d-none d-sm-inline">Menu</span>
            </button>
        </nav>
    </div>
</header>

<main id="main" role="main">
    @RenderBody()
</main>

<footer class="zp-footer" role="contentinfo">
    <div class="zp-container">
        <div class="zp-footer-grid">
            <div>
                <img class="zp-footer-logo" src="~/images/logo-light.svg" asp-append-version="true" alt="ZeroPrime Technologies" width="240" height="64" />
                <p>ZeroPrime Technologies is an Egyptian startup founded in 2017, building smart, sustainable cities infrastructure - starting with autonomous waste management and CanBank, a reverse vending machine.</p>
                @await Component.InvokeAsync("SocialLinks")
            </div>
            <nav aria-label="Explore">
                <h3 class="zp-footer-heading">Explore</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                    <li><a asp-controller="About" asp-action="Index">About us</a></li>
                    <li><a asp-controller="Products" asp-action="Index">CanBank</a></li>
                    <li><a asp-controller="SmartCities" asp-action="Index">Smart Cities</a></li>
                    <li><a asp-controller="Contact" asp-action="Index">Contact</a></li>
                </ul>
            </nav>
            <nav aria-label="Legal">
                <h3 class="zp-footer-heading">Legal</h3>
                <ul>
                    <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                    <li><a asp-controller="Home" asp-action="Terms">Terms &amp; Conditions</a></li>
                </ul>
            </nav>
            <div>
                <h3 class="zp-footer-heading">Contact</h3>
                <ul>
                    <li><a href="mailto:zeroprime.tech@gmail.com">zeroprime.tech@gmail.com</a></li>
                    <li>Cairo, Al Qahirah, Egypt</li>
                </ul>
            </div>
        </div>
        <div class="zp-footer-bottom">
            <span class="zp-footer-legal">&copy; @DateTime.UtcNow.Year ZeroPrime Technologies. All rights reserved. <span class="zp-footer-sep" aria-hidden="true">&middot;</span> <a class="zp-footer-build" href="https://eraasoft.com" target="_blank" rel="noopener noreferrer">EraaSoft</a></span>
            <span class="zp-pay-cards" role="group" aria-label="Accepted payment methods">
                <svg viewBox="0 0 34 22" class="zp-card-glyph" role="img" aria-label="Visa"><rect x="0.5" y="0.5" width="33" height="21" rx="3" fill="#1a1f71" stroke="rgba(255,255,255,0.25)"/><text x="17" y="14" text-anchor="middle" font-family="'Segoe UI', system-ui, sans-serif" font-size="8" font-style="italic" font-weight="800" letter-spacing="1.2" fill="#ffffff">VISA</text></svg>
                <svg viewBox="0 0 34 22" class="zp-card-glyph" role="img" aria-label="Mastercard"><rect x="0.5" y="0.5" width="33" height="21" rx="3" fill="#171717" stroke="rgba(255,255,255,0.25)"/><circle cx="13.5" cy="11" r="6" fill="#eb001b"/><circle cx="20.5" cy="11" r="6" fill="#f79e1b" fill-opacity="0.85"/></svg>
                <svg viewBox="0 0 34 22" class="zp-card-glyph" role="img" aria-label="American Express"><rect x="0.5" y="0.5" width="33" height="21" rx="3" fill="#2e77bc" stroke="rgba(255,255,255,0.25)"/><text x="17" y="13.2" text-anchor="middle" font-family="'Segoe UI', system-ui, sans-serif" font-size="6.2" font-weight="800" letter-spacing="0.8" fill="#ffffff">AMEX</text></svg>
                <svg viewBox="0 0 34 22" class="zp-card-glyph" role="img" aria-label="Meeza"><rect x="0.5" y="0.5" width="33" height="21" rx="3" fill="#0f9d8f" stroke="rgba(255,255,255,0.25)"/><text x="17" y="13.6" text-anchor="middle" font-family="'Segoe UI', system-ui, sans-serif" font-size="7" font-weight="800" letter-spacing="0.6" fill="#ffffff">meeza</text></svg>
            </span>
        </div>
    </div>
</footer>

<!-- Scroll to top -->
<button type="button" class="zp-scroll-top" id="zpScrollTop" aria-label="Scroll to top">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="M6 11l6-6 6 6"/></svg>
</button>

<!-- Cookie consent banner (real app behavior: delayed fade-in, persisted choice) -->
<div class="zp-consent" id="zpCookieConsent" role="dialog" aria-modal="false" aria-labelledby="zpConsentTitle" aria-describedby="zpConsentText" aria-hidden="true">
    <div class="zp-consent-card">
        <div class="zp-consent-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M21.3 11.1A8.6 8.6 0 1 0 12.9 2.7a5.4 5.4 0 0 0 6.3 6.8 4.7 4.7 0 0 0 2.1 1.6z"/><circle cx="9.5" cy="9.7" r="0.9"/><circle cx="13.6" cy="14.1" r="0.9"/><circle cx="9" cy="14.6" r="0.6"/></svg>
        </div>
        <div class="zp-consent-body">
            <p class="zp-consent-title" id="zpConsentTitle">We respect your privacy</p>
            <p class="zp-consent-text" id="zpConsentText">We use a small set of strictly necessary cookies and local storage — theme preference and your cookie choice. No tracking, no advertising, no analytics. <a asp-controller="Home" asp-action="Privacy">Read our Privacy Policy</a>.</p>
            <div class="zp-consent-actions">
                <button type="button" class="zp-btn zp-btn--amber zp-btn--sm" id="zpConsentAccept">Accept</button>
                <button type="button" class="zp-btn zp-btn--outline-dark zp-btn--sm" id="zpConsentEssentials">Essentials only</button>
            </div>
        </div>
        <button type="button" class="zp-consent-close" id="zpConsentClose" aria-label="Dismiss cookie notice">&times;</button>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/cookie-consent.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
