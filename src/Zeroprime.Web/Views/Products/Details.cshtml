@model Zeroprime.Web.ViewModels.Products.ProductDetailsViewModel
@{
    var product = Model.Product;
    ViewData["Title"] = $"{product.Name} — {product.Category}";
    ViewData["Description"] = $"{product.Name} by ZeroPrime Technologies: {product.Category} that rewards recycling of aluminum cans and plastic bottles with mobile phone credit, promotional codes, or charity donations.";
    ViewData["OgType"] = "product";
    var crumbs = new[]
    {
        new Zeroprime.Web.ViewModels.BreadcrumbItem("Home", "/"),
        new Zeroprime.Web.ViewModels.BreadcrumbItem("CanBank", "/products"),
        new Zeroprime.Web.ViewModels.BreadcrumbItem(product.Name)
    };
}

<partial name="_Breadcrumb" model="crumbs" />

<section class="zp-section zp-section--tight">
    <div class="zp-container">
        <div class="zp-grid-2" style="align-items: center;">
            <div style="text-align: center; background: var(--zp-green-50); border: 1px solid var(--zp-border); border-radius: var(--zp-radius-lg); padding: 2rem;">
                <img src="@product.ImageUrl" asp-append-version="true" alt="Illustration of the @product.Name reverse vending machine" width="420" height="560" style="max-width: 250px; width: 100%; height: auto; filter: drop-shadow(0 18px 28px rgba(14,47,36,0.25));" />
            </div>
            <div>
                <span class="zp-chip">@product.Category</span>
                <h1 class="zp-section-title" style="margin-top: 0.75rem; font-size: clamp(2rem, 4vw, 3rem);">@product.Name</h1>
                <p class="zp-lead">@product.Description</p>

                <h2 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.6rem;">Key features</h2>
                <ul class="zp-feature-list" style="color: inherit;">
                    @foreach (var feature in product.KeyFeatures)
                    {
                        <li style="color: var(--zp-ink);">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#1d7a4f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color:#1d7a4f;"><path d="M4 12.5l5 5L20 6.5"/></svg>
                            @feature
                        </li>
                    }
                </ul>

                <h2 style="font-size: 1.05rem; margin-top: 1.5rem; margin-bottom: 0.6rem;">Designed for</h2>
                <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem;">
                    @foreach (var location in product.TargetLocations)
                    {
                        <li class="zp-chip">@location</li>
                    }
                </ul>

                <div style="margin-top: 1.75rem; display:flex; gap: 0.75rem; flex-wrap: wrap;">
                    <a class="zp-btn zp-btn--dark" asp-controller="Contact" asp-action="Index">Request CanBank for your venue</a>
                    <a class="zp-btn zp-btn--outline-dark" asp-controller="SmartCities" asp-action="Index">Our smart-cities vision</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Business model -->
<section class="zp-section zp-section--tint" aria-labelledby="business-model">
    <div class="zp-container">
        <span class="zp-eyebrow">How it creates value</span>
        <h2 class="zp-section-title" id="business-model">One machine, three clear wins.</h2>
        <div class="zp-grid-3" style="margin-top: 2rem;">
            <article class="zp-card"><h3>For users</h3><p>Instant rewards for recycling — mobile phone credit, promotional codes, or the option to donate the reward to a charitable organization.</p></article>
            <article class="zp-card"><h3>For businesses</h3><p>A promotional platform with high visibility in high-traffic venues — turning a sustainability gesture into brand presence.</p></article>
            <article class="zp-card"><h3>For the environment</h3><p>Sorted, clean streams of aluminum cans and plastic bottles that are collected and subsequently recycled.</p></article>
        </div>

        <div class="zp-alert zp-alert--info" style="margin-top: 2rem;">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg>
            <div>CanBank represents the <strong>first component</strong> of a comprehensive waste collection system being developed by ZeroPrime Technologies. Deployment details and availability for specific venues are discussed during onboarding — <a asp-controller="Contact" asp-action="Index">contact the team</a> for current information.</div>
        </div>
    </div>
</section>
