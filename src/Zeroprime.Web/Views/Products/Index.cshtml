@model Zeroprime.Web.ViewModels.Products.ProductListViewModel
@{
    ViewData["Title"] = "CanBank — Reverse Vending Machine";
    ViewData["Description"] = "CanBank is a reverse vending machine by ZeroPrime Technologies that rewards users with mobile phone credit or promotional codes for recycling aluminum cans and plastic bottles, with an optional charity donation.";
    ViewData["OgType"] = "product";
    var crumbs = new[]
    {
        new Zeroprime.Web.ViewModels.BreadcrumbItem("Home", "/"),
        new Zeroprime.Web.ViewModels.BreadcrumbItem("CanBank")
    };
}

<partial name="_Breadcrumb" model="crumbs" />

<section class="zp-section zp-section--tight">
    <div class="zp-container">
        <span class="zp-eyebrow">Our product</span>
        <h1 class="zp-section-title" style="font-size: clamp(2rem, 4.5vw, 3.2rem);">CanBank</h1>
        <p class="zp-lead">A reverse vending machine that turns aluminum cans and plastic bottles into instant rewards — the first component of ZeroPrime Technologies' comprehensive waste collection system.</p>
    </div>
</section>

@if (Model.Products.Count == 0)
{
    <section class="zp-section--tight">
        <div class="zp-container">
            <div class="zp-alert zp-alert--info">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><path d="M12 8h.01"/></svg>
                <div><strong>Product information is being prepared.</strong> Please check back soon or <a asp-controller="Contact" asp-action="Index">contact us</a> with your questions.</div>
            </div>
        </div>
    </section>
}
else
{
    <section class="zp-section--tight" aria-label="Products">
        <div class="zp-container">
            @foreach (var product in Model.Products)
            {
                <article class="zp-product-panel" style="margin-bottom: 1.5rem;">
                    <div class="zp-product-media">
                        <img src="@product.ImageUrl" asp-append-version="true" alt="Illustration of the CanBank reverse vending machine" width="420" height="560" loading="lazy" style="max-width: 230px; width: 100%; height: auto; filter: drop-shadow(0 18px 32px rgba(0,0,0,0.4));" />
                    </div>
                    <div class="zp-product-body">
                        <span class="zp-chip zp-chip--dark">@product.Category</span>
                        <h2 style="color:#fff; margin-top: 0.75rem;">@product.Name</h2>
                        <p>@product.Description</p>
                        <div style="margin-top: 1.5rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
                            <a class="zp-btn zp-btn--amber" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">View details</a>
                            <a class="zp-btn zp-btn--outline" asp-controller="Contact" asp-action="Index">Request a demo</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </section>
}

<section class="zp-section zp-section--tint" aria-labelledby="target-locations">
    <div class="zp-container">
        <span class="zp-eyebrow">Where it deploys</span>
        <h2 class="zp-section-title" id="target-locations">High-traffic public spaces.</h2>
        <p class="zp-lead">CanBank is designed for venues where large numbers of people consume beverages on the go:</p>
        <ul style="list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.6rem;">
            @foreach (var location in (Model.Products.FirstOrDefault()?.TargetLocations ?? []))
            {
                <li class="zp-chip" style="font-size: 0.95rem; padding: 0.45rem 1rem;">@location</li>
            }
        </ul>
    </div>
</section>
